# Password del database Postgres (usata anche per comporre DATABASE_URL in docker-compose)
POSTGRES_PASSWORD=changeme
# Porta host di Postgres (solo 127.0.0.1); cambiala se 5432 è già occupata da un altro progetto
DB_PORT=5432

# Chiave API Anthropic, usata per l'estrazione AI delle ricette importate.
# Opzionale se è valorizzata GROQ_API_KEY o OPENROUTER_API_KEY: se assente (o se la chiamata
# fallisce), l'app passa automaticamente a Groq, poi a OpenRouter. Se tutte e tre sono assenti
# l'import AI non è disponibile, ma il resto dell'app (inserimento manuale incluso) funziona comunque.
ANTHROPIC_API_KEY=

# Modello Claude da usare per l'estrazione (default: economico, supporta structured output)
ANTHROPIC_MODEL=claude-haiku-4-5

# Chiave API Groq (console.groq.com/keys), provata dopo Anthropic e prima di OpenRouter.
GROQ_API_KEY=

# Modello Groq da usare (default: veloce, gratuito, supporta structured output).
# Solo openai/gpt-oss-20b e openai/gpt-oss-120b supportano response_format json_schema su Groq:
# https://console.groq.com/docs/structured-outputs#supported-models
GROQ_MODEL=openai/gpt-oss-20b

# Chiave API OpenRouter (openrouter.ai/keys), usata come ultimo fallback se Anthropic e Groq
# non sono configurate o falliscono. Prova automaticamente i modelli gratuiti disponibili, dal
# più al meno capace (scoperti a runtime, nessuna configurazione di modelli necessaria).
OPENROUTER_API_KEY=

# Solo per debug: forza un modello OpenRouter specifico (es. "meta-llama/llama-3.3-70b-instruct:free")
# invece della scoperta automatica. Lascia vuoto in uso normale.
OPENROUTER_MODEL_OVERRIDE=

# Credenziali dell'utente admin: create/aggiornate automaticamente a ogni avvio del container
# (upsert per email, vedi lib/seed.ts). Per aggiungere altri utenti, usa Impostazioni > Utenti
# nell'app da loggato come admin, invece di cambiare questi valori.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# Imposta a "false" per deploy su LAN senza HTTPS (reverse proxy/TLS assente)
COOKIE_SECURE=true

# Solo per `npm run dev` locale (fuori Docker) - in Docker viene composta automaticamente
DATABASE_URL=postgresql://recipebook:changeme@localhost:5432/recipebook

# Cartella dove vengono salvate le immagini caricate (foto ricette, galleria, step).
# In Docker è impostata a /data/uploads (volume persistente, vedi docker-compose.yml).
UPLOAD_DIR=./data/uploads

# Cartella dei dati Tesseract per l'OCR (impostata nel Dockerfile; in locale lasciare vuota)
TESSDATA_PREFIX=
