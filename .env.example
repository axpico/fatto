# Password del database Postgres (usata anche per comporre DATABASE_URL in docker-compose)
POSTGRES_PASSWORD=changeme

# Chiave API Anthropic, usata per l'estrazione AI delle ricette importate.
# Opzionale se è valorizzata OPENROUTER_API_KEY: se assente (o se la chiamata fallisce), l'app
# passa automaticamente a OpenRouter. Se entrambe sono assenti l'import AI non è disponibile,
# ma il resto dell'app (inserimento manuale incluso) funziona comunque.
ANTHROPIC_API_KEY=

# Modello Claude da usare per l'estrazione (default: economico, supporta structured output)
ANTHROPIC_MODEL=claude-haiku-4-5

# Chiave API OpenRouter (openrouter.ai/keys), usata come fallback se Anthropic non è
# configurata o fallisce. Prova automaticamente i modelli gratuiti disponibili, dal più al
# meno capace (scoperti a runtime, nessuna configurazione di modelli necessaria).
OPENROUTER_API_KEY=

# Solo per debug: forza un modello OpenRouter specifico (es. "meta-llama/llama-3.3-70b-instruct:free")
# invece della scoperta automatica. Lascia vuoto in uso normale.
OPENROUTER_MODEL_OVERRIDE=

# Credenziali del primo utente: create/aggiornate automaticamente a ogni avvio del container
# (upsert per email, vedi lib/seed.ts). Per aggiungere un secondo utente: cambia questi valori
# e riavvia il container (`docker compose up -d --force-recreate app`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# Imposta a "false" per deploy su LAN senza HTTPS (reverse proxy/TLS assente)
COOKIE_SECURE=true

# Solo per `npm run dev` locale (fuori Docker) - in Docker viene composta automaticamente
DATABASE_URL=postgresql://recipebook:changeme@localhost:5432/recipebook
